<configuration>
    <input>
        <net-file value="research.net.xml"/>
        <route-files value="research.rou.xml"/>
    </input>
    <output>
        <tripinfo-output value="results/tripinfo_tmp.xml"/>
    </output>
    <time>
        <begin value="0"/>
        <end value="7200"/>
        <step-length value="1"/>
    </time>
    <processing>
        <time-to-teleport value="-1"/>
    </processing>
    <report>
        <verbose value="false"/>
        <no-step-log value="true"/>
    </report>
</configuration>